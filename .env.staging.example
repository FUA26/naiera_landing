# Staging Environment Variables
# Copy this file to .env.staging and update with your staging values

# Node Environment
NODE_ENV=production

# Application Configuration
NEXT_PUBLIC_APP_URL=http://your-staging-server.com:3000
NEXT_PUBLIC_APP_NAME="Naiera Landing - Staging"

# n8n Chat Webhook URL (optional)
# NEXT_PUBLIC_N8N_CHAT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/chat
